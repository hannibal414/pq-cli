#: pqcli/__main__.py:27
msgid "Use basic user interface (very crude, but uses least CPU)"
msgstr "シンプルなUIを使う（簡素だがCPU消費が最小）"

#: pqcli/__main__.py:34
msgid "Use curses user interface (fast, but no colors output)"
msgstr "curses UIを使う（高速だが色表示なし）"

#: pqcli/__main__.py:41
msgid "Disable color highlighting in curses interface"
msgstr "curses UIの色分け表示を無効にする"

#: pqcli/__main__.py:54
msgid "list saved characters and exit"
msgstr "保存済みキャラクターを一覧表示して終了する"

#: pqcli/__main__.py:60
msgid "play chosen character"
msgstr "指定したキャラクターでプレイする"

#: pqcli/__main__.py:75
msgid "No saved characters found. Starting first-run character creation."
msgstr "保存済みキャラクターがありません。初回キャラクター作成を開始します。"

#: pqcli/__main__.py:83
msgid "No character created. Do you want to try again?"
msgstr "キャラクターが作成されませんでした。もう一度試しますか？"

#: pqcli/__main__.py:85
msgid "A character is required for first run."
msgstr "初回起動にはキャラクターが必要です。"

#: pqcli/__main__.py:102
msgid "Invalid player. Available players:"
msgstr "無効なプレイヤーです。選択可能なプレイヤー:"

#: pqcli/lingo.py:81
msgid "Prologue"
msgstr "プロローグ"

#: pqcli/lingo.py:82
#, python-brace-format
msgid "Act {numeral}"
msgstr "第{numeral}幕"

#: pqcli/lingo.py:152
msgid "faithful"
msgstr "忠実な"

#: pqcli/lingo.py:152
msgid "noble"
msgstr "高潔な"

#: pqcli/lingo.py:152
msgid "loyal"
msgstr "忠義の"

#: pqcli/lingo.py:152
msgid "brave"
msgstr "勇敢な"

#: pqcli/lingo.py:154
#, python-brace-format
msgid "Terminate {adjective} {name}?"
msgstr "{adjective}{name}を消去しますか？"

#: pqcli/mechanic.py:146
#, python-brace-format
msgid "Increased {stat} to {value}"
msgstr "{stat}が{value}に上昇した"

#: pqcli/mechanic.py:182
#, python-brace-format
msgid "Commencing quest: {quest}"
msgstr "クエスト開始: {quest}"

#: pqcli/mechanic.py:218
#, python-brace-format
msgid "Spent {gold}"
msgstr "{gold}を支払った"

#: pqcli/mechanic.py:218
#, python-brace-format
msgid "Got paid {gold}"
msgstr "{gold}を受け取った"

#: pqcli/mechanic.py:227
#, python-brace-format
msgid "Lost {item}"
msgstr "{item}を失った"

#: pqcli/mechanic.py:235
#, python-brace-format
msgid "Gained {item}"
msgstr "{item}を手に入れた"

#: pqcli/mechanic.py:308 pqcli/mechanic.py:318
#, python-brace-format
msgid "Learned {spell} at level {level}"
msgstr "{spell}をレベル{level}で習得した"

#: pqcli/mechanic.py:411
#, python-brace-format
msgid "Leveled up to level {level}!"
msgstr "レベル{level}に上がった！"

#: pqcli/mechanic.py:498
#, python-brace-format
msgid "Gained {item} {slot}"
msgstr "{item}（{slot}）を手に入れた"

#: pqcli/mechanic.py:515
msgid "Loading"
msgstr "ロード中"

#: pqcli/mechanic.py:518
msgid "Experiencing an enigmatic and foreboding night vision"
msgstr "不可解で不吉な夜の幻視を見ている"

#: pqcli/mechanic.py:523
msgid "Much is revealed about that wise old bastard you'd underestimated"
msgstr "見くびっていたあの老賢者について多くが明かされる"

#: pqcli/mechanic.py:530
msgid "A shocking series of events leaves you alone and bewildered, but resolute"
msgstr "衝撃的な出来事の連続に、孤独と困惑を抱えながらも決意を固める"

#: pqcli/mechanic.py:537
msgid ""
"Drawing upon an unrealized reserve of determination, you set out on a "
"long and dangerous journey"
msgstr "眠っていた決意を呼び起こし、長く危険な旅に出る"

#: pqcli/mechanic.py:542 pqcli/mechanic.py:879
#, python-brace-format
msgid "Loading {act}"
msgstr "{act}をロード中"

#: pqcli/mechanic.py:620
#, python-brace-format
msgid "Selling {item}"
msgstr "{item}を売却中"

#: pqcli/mechanic.py:637
msgid "Heading to market to sell loot"
msgstr "戦利品を売りに市場へ向かっている"

#: pqcli/mechanic.py:644
msgid "Negotiating purchase of better equipment"
msgstr "より良い装備の購入を交渉中"

#: pqcli/mechanic.py:650
msgid "Heading to the killing fields"
msgstr "狩場へ向かっている"

#: pqcli/mechanic.py:673
#, python-brace-format
msgid "Quest completed: {quest}"
msgstr "クエスト達成: {quest}"

#: pqcli/mechanic.py:693
#, python-brace-format
msgid "Exterminate {monsters}"
msgstr "{monsters}を殲滅せよ"

#: pqcli/mechanic.py:697
#, python-brace-format
msgid "Seek {item}"
msgstr "{item}を探し出せ"

#: pqcli/mechanic.py:701
#, python-brace-format
msgid "Deliver this {item}"
msgstr "この{item}を届けよ"

#: pqcli/mechanic.py:703
#, python-brace-format
msgid "Fetch me {item}"
msgstr "{item}を持ってこい"

#: pqcli/mechanic.py:708
#, python-brace-format
msgid "Placate {monsters}"
msgstr "{monsters}をなだめよ"

#: pqcli/mechanic.py:727
msgid "Exhausted, you arrive at a friendly oasis in a hostile land"
msgstr "疲れ果て、敵地の中の安らげるオアシスにたどり着く"

#: pqcli/mechanic.py:735
msgid "You greet old friends and meet new allies"
msgstr "旧友と再会し、新たな仲間と出会う"

#: pqcli/mechanic.py:740
msgid "You are privy to a council of powerful do-gooders"
msgstr "有力な善人たちの評議会に加わる"

#: pqcli/mechanic.py:746
msgid "There is much to be done. You are chosen!"
msgstr "為すべきことは山積みだ。あなたが選ばれた！"

#: pqcli/mechanic.py:754
msgid "Your quarry is in sight, but a mighty enemy bars your path!"
msgstr "獲物は目前、しかし強大な敵が行く手を阻む！"

#: pqcli/mechanic.py:765
#, python-brace-format
msgid "A desperate struggle commences with {nemesis}"
msgstr "{nemesis}との死闘が始まる"

#: pqcli/mechanic.py:780
#, python-brace-format
msgid "Locked in grim combat with {nemesis}"
msgstr "{nemesis}と激しい戦いを繰り広げている"

#: pqcli/mechanic.py:789
#, python-brace-format
msgid "{nemesis} seems to have the upper hand"
msgstr "{nemesis}が優勢に見える"

#: pqcli/mechanic.py:799
#, python-brace-format
msgid "You seem to gain the advantage over {nemesis}"
msgstr "{nemesis}に対して優勢になってきたようだ"

#: pqcli/mechanic.py:810
#, python-brace-format
msgid "Victory! {nemesis} is slain! Exhausted, you lose consciousness"
msgstr "勝利！{nemesis}を討ち取った！力尽きて意識を失う"

#: pqcli/mechanic.py:818
msgid "You awake in a friendly place, but the road awaits"
msgstr "安全な場所で目を覚ますが、旅路はまだ続く"

#: pqcli/mechanic.py:828
#, python-brace-format
msgid "Oh sweet relief! You've reached the protection of the good {nemesis}"
msgstr "ああ、なんという安堵！善良なる{nemesis}の庇護にたどり着いた"

#: pqcli/mechanic.py:837
#, python-brace-format
msgid "There is rejoicing, and an unnerving encounter with {nemesis} in private"
msgstr "歓喜に沸くなか、{nemesis}との不穏な密会が待つ"

#: pqcli/mechanic.py:845
#, python-brace-format
msgid "You forget your {item} and go back to get it"
msgstr "{item}を忘れたので取りに戻る"

#: pqcli/mechanic.py:853
msgid "What's this!? You overhear something shocking!"
msgstr "なんだと！？衝撃的な話を漏れ聞いてしまった！"

#: pqcli/mechanic.py:858
#, python-brace-format
msgid "Could {nemesis} be a dirty double-dealer?"
msgstr "{nemesis}は汚い裏切り者なのか？"

#: pqcli/mechanic.py:867
msgid "Who can possibly be trusted with this news!? ... Oh yes, of course"
msgstr "この知らせを託せる者は誰だ！？……ああ、もちろんあの人だ"

#: pqcli/mechanic.py:1010
#, python-brace-format
msgid "Executing {monster}"
msgstr "{monster}を討伐中"

#: pqcli/ui/basic/__init__.py:45
msgid "Quitting"
msgstr "終了しています"

#: pqcli/ui/basic/__init__.py:72
msgid "Create a new character"
msgstr "新しいキャラクターを作成"

#: pqcli/ui/basic/__init__.py:73
msgid "Play as character"
msgstr "キャラクターでプレイ"

#: pqcli/ui/basic/__init__.py:74
msgid "Query character info"
msgstr "キャラクター情報を表示"

#: pqcli/ui/basic/__init__.py:75
msgid "Delete a character"
msgstr "キャラクターを削除"

#: pqcli/ui/basic/__init__.py:76
msgid "Quit"
msgstr "終了"

#: pqcli/ui/basic/__init__.py:106
msgid "Name your new character: "
msgstr "新しいキャラクターの名前: "

#: pqcli/ui/basic/__init__.py:108
msgid "Cancelled."
msgstr "キャンセルしました。"

#: pqcli/ui/basic/__init__.py:120
#, python-brace-format
msgid "Total: {total}"
msgstr "合計: {total}"

#: pqcli/ui/basic/__init__.py:121
msgid "Is this okay?"
msgstr "これでよろしいですか？"

#: pqcli/ui/basic/__init__.py:129
msgid "Do you want to play as your new character?"
msgstr "作成したキャラクターでプレイしますか？"

#: pqcli/ui/basic/__init__.py:135
#, python-brace-format
msgid "Playing as {name}"
msgstr "{name}でプレイ中"

